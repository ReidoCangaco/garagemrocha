# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anonima-aqui
# NUNCA prefixar com NEXT_PUBLIC_ — essa chave nunca pode ir ao navegador
SUPABASE_SERVICE_ROLE_KEY=chave-service-role-aqui

# URL pública do site (usada para montar os links do portal)
NEXT_PUBLIC_SITE_URL=https://garagemrocha.vercel.app

# Dados fixos do recebedor PIX (MVP sem provedor — ver README)
PIX_CHAVE=11122233344
PIX_NOME_RECEBEDOR=GARAGEM ROCHA
PIX_CIDADE=SAO PAULO

# Usado só pelo script scripts/criar-admin.mjs (não entra no app)
ADMIN_EMAIL=pai@exemplo.com
ADMIN_SENHA=escolha-uma-senha-forte
ADMIN_NOME="Seu Nome"
